---
// The main tool: type text, get a list of fancy styles, tap one to copy.
// mode="fonts": plain font styles first, then decorated ones.
// mode="names": decorated gaming-name styles first (Free Fire, PUBG...).
// The 300x250 banner sits after the first few styles, where visitors actually look.
import AdSlot from './AdSlot.astro';
import { STYLES, DECORATIONS, decorate } from '../lib/fonts.js';
import { STYLE_CATEGORIES } from '../lib/style-categories.js';

interface Props {
  mode?: 'fonts' | 'names';
  placeholder?: string;
  sample?: string;
}

const { mode = 'fonts', placeholder = 'Type your text here…', sample = 'Fancy Font' } = Astro.props;
const nameStyles = STYLES.filter((s) =>
  ['Bold', 'Bold Script', 'Script', 'Bold Gothic', 'Gothic', 'Double Struck', 'Small Caps',
    'Sans Bold', 'Bold Italic', 'Monospace', 'Thai Style', 'Magic', 'Russian Style', 'Tiny',
    'Greek Style', 'Wide', 'Black Bubble', 'Bubble'].includes(s.name),
);
const initialStyles = mode === 'names'
  ? DECORATIONS.slice(0, 8).map((d, i) => {
      const style = nameStyles[(i * 7) % nameStyles.length];
      return { label: `${style.name} + decoration`, value: decorate(style.fn(sample), d) };
    })
  : STYLES.slice(0, 8).map((style) => ({ label: style.name, value: style.fn(sample) }));
---

<div class="font-gen" data-mode={mode} data-sample={sample}>
  <div class="tool-box card">
    <input class="input" type="text" placeholder={placeholder} aria-label="Your text" maxlength="200" />
    <div class="row" style="margin-top:10px">
      <button type="button" class="btn secondary small shuffle">🎲 Shuffle styles</button>
      <button type="button" class="btn secondary small clear">✖ Clear</button>
      <span class="muted" style="font-size:.85rem">Tap any style to copy</span>
    </div>
  </div>
  <div class="tabs style-filters" role="group" aria-label="Filter font styles" hidden>
    {STYLE_CATEGORIES.map((category) => (
      <button type="button" data-category={category.id} aria-pressed={category.id === 'all'} class:list={{ active: category.id === 'all' }}>{category.label}</button>
    ))}
  </div>
  <div class="results results-top" aria-live="polite">
    {initialStyles.map((style) => (
      <div class="result" data-copy={style.value} role="button" tabindex="0">
        <div class="body"><span class="label">{style.label}</span><span class="text">{style.value}</span></div>
        <span class="btn small copy-btn">Copy</span>
      </div>
    ))}
  </div>
  <noscript><p>Enable JavaScript to generate styles from your own text and copy them with a tap. You can select and copy these examples manually.</p></noscript>
  <AdSlot slot="banner300x250" />
  <div class="results results-rest"></div>
</div>

<script>
  import { STYLES, DECORATIONS, decorate } from '../lib/fonts.js';
  import { matchesCategory } from '../lib/style-categories.js';

  const escapeHtml = (s) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  // Styles that read well inside a decoration.
  const NAME_STYLES = STYLES.filter((s) =>
    ['Bold', 'Bold Script', 'Script', 'Bold Gothic', 'Gothic', 'Double Struck', 'Small Caps',
      'Sans Bold', 'Bold Italic', 'Monospace', 'Thai Style', 'Magic', 'Russian Style', 'Tiny',
      'Greek Style', 'Wide', 'Black Bubble', 'Bubble'].includes(s.name),
  );

  // How many styles appear above the in-list ad.
  const TOP_COUNT = 8;

  for (const root of document.querySelectorAll('.font-gen')) {
    const input = root.querySelector('input');
    const listTop = root.querySelector('.results-top');
    const listRest = root.querySelector('.results-rest');
    const mode = root.dataset.mode;
    const sample = root.dataset.sample;
    let seed = 0;
    let category = 'all';
    const filters = root.querySelector('.style-filters');
    filters.hidden = false;

    const pickStyle = (i) => NAME_STYLES[(i * 7 + seed) % NAME_STYLES.length];

    function build(text) {
      const plain = STYLES.map((s) => ({ label: s.name, value: s.fn(text), decorated: false }));
      const decorated = DECORATIONS.map((d, i) => {
        const s = pickStyle(i);
        return { label: `${s.name} + decoration`, value: decorate(s.fn(text), d), decorated: true };
      });
      return mode === 'names' ? [...decorated, ...plain] : [...plain, ...decorated];
    }

    function render() {
      const text = input.value.trim() || sample;
      const html = build(text).filter((result) => matchesCategory(result, category)).map(
        (r) => `<div class="result" data-copy="${escapeHtml(r.value)}" role="button" tabindex="0">
          <div class="body"><span class="label">${escapeHtml(r.label)}</span><span class="text">${escapeHtml(r.value)}</span></div>
          <span class="btn small copy-btn">Copy</span>
        </div>`,
      );
      listTop.innerHTML = html.slice(0, TOP_COUNT).join('');
      listRest.innerHTML = html.slice(TOP_COUNT).join('');
    }

    input.addEventListener('input', render);
    filters.addEventListener('click', (event) => {
      const button = event.target.closest('[data-category]');
      if (!button) return;
      category = button.dataset.category;
      for (const option of filters.querySelectorAll('button')) {
        const selected = option === button;
        option.classList.toggle('active', selected);
        option.setAttribute('aria-pressed', String(selected));
      }
      render();
    });
    root.querySelector('.shuffle').addEventListener('click', () => {
      seed = Math.floor(Math.random() * 1000);
      render();
    });
    root.querySelector('.clear').addEventListener('click', () => {
      input.value = '';
      input.focus();
      render();
    });
    root.addEventListener('keydown', (e) => {
      if (['Enter', ' '].includes(e.key) && e.target.matches('.result')) {
        e.preventDefault();
        e.target.click();
      }
    });

    render();
  }
</script>
