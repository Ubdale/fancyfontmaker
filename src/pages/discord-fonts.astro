---
import Base from '../layouts/Base.astro';
import FontGenerator from '../components/FontGenerator.astro';
import CopyExamples from '../components/CopyExamples.astro';
const examples = [
  { label: 'General channel', value: '「💬」ɢᴇɴᴇʀᴀʟ' },
  { label: 'Announcements channel', value: '📢・𝐚𝐧𝐧𝐨𝐮𝐧𝐜𝐞𝐦𝐞𝐧𝐭𝐬' },
  { label: 'Gaming channel', value: '🎮・ɢᴀᴍɪɴɢ' },
  { label: 'Display name', value: '✦ 𝓐𝓵𝓮𝔁 ✦' },
];

const faq = [
  {
    q: 'How do I use fancy fonts on Discord?',
    a: 'Copy a style from this page and paste it into your nickname, server name, channel name or any message.',
  },
  {
    q: 'Can I use fancy fonts in Discord channel names?',
    a: 'Yes. Discord channel names support most Unicode fonts, although spaces are turned into dashes in text channels.',
  },
  {
    q: 'Is this the same as Discord markdown?',
    a: 'No. Markdown like **bold** only works in messages. Unicode fonts from this page work everywhere, including names.',
  },
];
---

<Base
  title="Discord Font Generator — Copy and Paste Names & Text"
  description="Discord fonts generator. Copy and paste fancy fonts for your Discord nickname, server name, channel names and messages. Free."
  h1="Discord Fonts 𝕮𝖔𝖕𝖞 & 𝕻𝖆𝖘𝖙𝖊"
  intro="Style your Discord nickname, server and channels with fancy Unicode fonts. Tap any style to copy."
  faq={faq}
  bottomBanner={false}
>
  <FontGenerator placeholder="Type your Discord name…" sample="Discord Server" />

  <Fragment slot="content">
    <section class="content">
      <CopyExamples title="Discord channel names to copy and paste" examples={examples} />
      <h2>Unicode text or Discord markdown?</h2>
      <p>For messages, Discord formatting such as **bold** uses ordinary letters and is easy to edit.
        For a decorated nickname or channel label, this generator creates Unicode characters that you can copy.
        Preview names in Discord, since spaces and character support may vary by field.</p>
      <p>Keep channel names recognisable so members can find announcements and help.
        Use decoration around a short label rather than replacing every letter of an important instruction.</p>
      <h2>Fonts for Discord servers</h2>
      <p>
        Server owners use fancy fonts to make channel lists look clean and organised, for example
        <b>「💬」ɢᴇɴᴇʀᴀʟ</b> or <b>📢・𝐚𝐧𝐧𝐨𝐮𝐧𝐜𝐞𝐦𝐞𝐧𝐭𝐬</b>. Small Caps and Bold are the most
        readable choices for channel names.
      </p>
      <p>Decorate further with <a href="/symbols/">cool symbols</a> like 「」 ・ ┊ ⌗.</p>
    </section>
  </Fragment>
</Base>
